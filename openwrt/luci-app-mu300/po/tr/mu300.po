msgstr "Yalnızca ana panonun yenileme hızını kontrol eder; 0,5–60 saniye. Kaydettikten sonra uygulamak için Ana Sayfa’yı yeniden açın."

msgid "Persistent state directory"
msgstr "Kalıcı durum dizini"

msgid "Recipient: number, e.g. 10086 or +86..."
msgstr "Alıcı: numara, ör. 10086 veya +86..."

msgid "Sync from SIM"
msgstr "SIM’den eşitle"

msgid "Clear local pool"
msgstr "Yerel havuzu temizle"

msgid "Loading…"
msgstr "Yükleniyor…"

msgid "Select a conversation on the left, or enter a number below to send."
msgstr "Soldan bir görüşme seçin veya göndermek için aşağıya bir numara girin."

msgid "Message (Enter to send, Shift+Enter for newline)"
msgstr "Mesaj (göndermek için Enter, yeni satır için Shift+Enter)"

msgid "Sending uses AT+CMGS (PDU mode); retry if the channel is busy. To delete one message, use the bin icon on its bubble."
msgstr "Gönderme AT+CMGS (PDU modu) kullanır; kanal meşgulse yeniden deneyin. Bir mesajı silmek için balonundaki çöp kutusu simgesini kullanın."

msgid "Syncing from the SIM in the background (AT+CMGL)…"
msgstr "SIM’den arka planda eşitleniyor (AT+CMGL)…"

msgid "SIM sync started; the list refreshes in a few seconds."
msgstr "SIM eşitlemesi başladı; liste birkaç saniye içinde yenilenecek."

msgid "Clear local SMS pool"
msgstr "Yerel SMS havuzunu temizle"

msgid "Only local files will be deleted; messages on the SIM remain."
msgstr "Yalnızca yerel dosyalar silinir; SIM’deki mesajlar korunur."

msgid "Clear"
msgstr "Temizle"

msgid "Delete this SMS"
msgstr "Bu SMS’i sil"

msgid "Deletion cannot be undone."
msgstr "Silme işlemi geri alınamaz."

msgid "Local only"
msgstr "Yalnızca yerel"

msgid "Local + SIM"
msgstr "Yerel + SIM"

msgid "Delete failed"
msgstr "Silme başarısız"

msgid "Deleted (local + SIM)"
msgstr "Silindi (yerel + SIM)"

msgid "Deleted (local only)"
msgstr "Silindi (yalnızca yerel)"

msgid "Enter both a number and a message."
msgstr "Numara ve mesaj girin."

msgid "Sending…"
msgstr "Gönderiliyor…"

msgid "Sent; the list refreshes shortly."
msgstr "Gönderildi; liste birazdan yenilenecek."

msgid "Sending failed: %s (the AT channel is busy, try again shortly)"
msgstr "Gönderme başarısız: %s (AT kanalı meşgul, birazdan yeniden deneyin)"

msgid "Sending failed: %s"
msgstr "Gönderme başarısız: %s"

msgid "· %d messages, %d unread · %d conversations"
msgstr "· %d mesaj, %d okunmamış · %d görüşme"

msgid "· %d messages · %d conversations"
msgstr "· %d mesaj · %d görüşme"

msgid "The pool is empty. Incoming and sent messages appear here, or select “Sync from SIM”."
msgstr "Havuz boş. Gelen ve gönderilen mesajlar burada görünür veya “SIM’den eşitle”yi seçin."

msgid "Me: %s"
msgstr "Ben: %s"

msgid "Delete"
msgstr "Sil"
