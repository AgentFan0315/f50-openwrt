[Unit]
Description=MU300 join the saved Wi-Fi network (station mode; stops the hotspot while connected)
ConditionPathExists=/etc/mu300/wifi-client.conf
After=mu300-wifi.service mu300-lan.service
Wants=mu300-wifi.service
Before=mu300-hotspot.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/mu300/bin/wifi-client up
# no ExecStop: at shutdown there is nothing to tear down (the radio is reset at the next boot anyway), and
# running "disconnect" there would also clear the scan-mode flag that the coming boot is meant to use

[Install]
WantedBy=multi-user.target
